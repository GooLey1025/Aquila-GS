{
    "random_seed": 42,
    "precision": "float32",
    "embedding": {
        "input_type": "SNP",
        "input_dims": 1,
        "Block_length": 1,
        "num_chromosomes": 10,
        "chromosome_embedding_dim": 2,
        "CNN_Kernel": [3, 5, 7, 9, 11, 13, 15, 17],
        "CNN_Dilation": [1, 2, 3, 4, 5, 6, 7, 8],
        "CNN_layers": 1,
        "dropout_rate": 0.1,
        "position_encoding": true,
        "max_pos_encoding_blocks": 40000,
        "normalization": false,
        "activation": "gelu",
        "aux_ffn_expansion_factor": 4
    },
    "GFI_FormerBLOCKS": {
        "num_blocks": 3,
        "blocks": [
            {
                "name": "GFI_Block0",
                "context_length": 32,
                "encoder": {
                    "num_layers": 8,
                    "attention": {
                        "type": "flash_attention",
                        "hidden_dims": 64,
                        "num_heads": 8,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    },
                    "ffn_sharing": false,
                    "ffn_expansion_factor": 4
                },
                "decoder": {
                    "num_layers": 1,
                    "cross_attention": {
                        "type": "flash_attention",
                        "head_dims": 8,
                        "num_heads": 8,
                        "dropout_rate": 0.1,
                        "temperature": 1.0,
                        "v_projection_source": "encoder"  
                    },
                    "MOE": {                        
                        "experts_dims": 64,
                        "num_experts": 6,                        
                        "exports_expansion_factor": 4,
                        "exports_sharing": false,
                        "capacity_factor" : 1.25,
                        "dropout_rate": 0.1,
                        "aux_ffn_expansion_factor": 4
                    },  
                    "pooling": {
                        "type": "self_attention",
                        "head_dims": 64,
                        "num_heads": 6,
                        "ffn_expansion_factor": 4,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    }                  
                } 
            },
            {
                "name": "GFI_Block1",
                "context_length": 32,
                "encoder": {
                    "num_layers": 6,
                    "attention": {
                        "type": "flash_attention",
                        "hidden_dims": 128,
                        "num_heads": 8,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    },
                    "ffn_sharing": false,
                    "ffn_expansion_factor": 4
                },
                "decoder": {
                    "num_layers": 1,
                    "cross_attention": {
                        "type": "flash_attention",
                        "head_dims": 16,
                        "num_heads": 8,
                        "dropout_rate": 0.1,
                        "temperature": 1.0,
                        "v_projection_source": "encoder"  
                    },
                    "MOE": {                        
                        "experts_dims": 128,
                        "num_experts": 6,                        
                        "exports_expansion_factor": 4,
                        "exports_sharing": false,
                        "capacity_factor" : 1.25,
                        "dropout_rate": 0.1,
                        "aux_ffn_expansion_factor": 4
                    },  
                    "pooling": {
                        "type": "self_attention",
                        "head_dims": 128,
                        "num_heads": 6,
                        "ffn_expansion_factor": 4,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    }                  
                } 
            },
            {
                "name": "GFI_Block2",
                "context_length": 64,
                "encoder": {
                    "num_layers": 4,
                    "attention": {
                        "type": "flash_attention",
                        "hidden_dims": 256,
                        "num_heads": 8,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    },
                    "ffn_sharing": false,
                    "ffn_expansion_factor": 4
                },
                "decoder": {
                    "num_layers": 1,
                    "cross_attention": {
                        "type": "flash_attention",
                        "head_dims": 32,
                        "num_heads": 8,
                        "dropout_rate": 0.1,
                        "temperature": 1.0,
                        "v_projection_source": "encoder"  
                    },
                    "MOE": {                        
                        "experts_dims": 128,
                        "num_experts": 6,                        
                        "exports_expansion_factor": 4,
                        "exports_sharing": false,
                        "capacity_factor" : 1.25,
                        "dropout_rate": 0.1,
                        "aux_ffn_expansion_factor": 4
                    },  
                    "pooling": {
                        "type": "self_attention",
                        "head_dims": 128,
                        "num_heads": 6,
                        "ffn_expansion_factor": 4,
                        "dropout_rate": 0.1,
                        "temperature": 1.0
                    }                  
                } 
            }
        ]
    },
    "output_layer": {
        "phenotype_dim": 6,
        "phenotype_name": ["tkw", "testw", "length", "width", "Hard", "Prot"],
        "hidden_expansion_dims": 4,
        "activation": "tanh",
        "dropout_rate": 0.1
    },
    "loss_config": {
        "primary_loss": {
            "enabled": true, 
            "type": "mse", 
            "pearson_factor": 0.2,
            "reduction": "mean" 
        },
        "auxiliary_losses": {
            "Deep_Supervision": {
                "enabled": true, 
                "type": "pearson", 
                "weight": [0.001, 0.01, 0.01, 0.01],
                "pearson_factor": 1,
                "reduction": "mean" 
            },
            "PWCosSim": {
                "enabled": false, 
                "weight": [0, 1, 1, 1],
                "PWCosSim_factor": 10,
                "reduction": "mean",
                "eps": 1e-8,
                "gamma": 1.0
            },
            "l1_regularization": {
                "enabled": false,
                "weight": 1.0e-8
            },
            "correlation": {
                "enabled": false,
                "weight": 0.01
            }
        }
    },
    "phenotype": {
        "distribution": "gaussian",
        "normalize": false,
        "scaling_method": "standard",
        "target_log_variance": 0
    }
}
